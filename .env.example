PORT=8787
TRANSLATION_MODE=mock
# live | mock

# Phrase Platform access token (exchanged server-side for a short-lived JWT)
PHRASE_API_TOKEN=
PHRASE_AUTH_MODE=platform
PHRASE_OAUTH_URL=https://eu.phrase.com/idm/oauth/token
# US datacenter: https://us.phrase.com/idm/oauth/token
PHRASE_BASE_URL=https://cloud.memsource.com/web
# US TMS: https://us.cloud.memsource.com/web

# Phrase project template UID (create project from template settings)
PHRASE_PROJECT_TEMPLATE_UID=

# Optional: MT engine numeric id for workflow step 3 (default: AI Translation Agent)
# PHRASE_WF3_MT_ID=5239171

# Auth — create the first admin once (then manage users in the app UI)
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_DAYS=7
# Set true when serving over HTTPS
AUTH_SECURE_COOKIE=false
# Optional legacy one-time import: user1:pass1|user2:pass2
# AUTH_USERS=

CORS_ORIGIN=*
MAX_UPLOAD_MB=50
