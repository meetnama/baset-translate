PORT=8787
TRANSLATION_MODE=mock
# live | mock

# TMS platform access token (exchanged server-side for a short-lived JWT)
TMS_API_TOKEN=
TMS_AUTH_MODE=platform
TMS_OAUTH_URL=https://eu.phrase.com/idm/oauth/token
# US datacenter: https://us.phrase.com/idm/oauth/token
TMS_BASE_URL=https://cloud.memsource.com/web
# US TMS: https://us.cloud.memsource.com/web

# Full workflow: 3-step project template
TMS_PROJECT_TEMPLATE_UID=FZg60dEA9Yj4nyvp1ka1K4

# Premium AI template (memory + lock terms + Agent)
TMS_AI_TEMPLATE_UID=rSLTo7avyCpO65101YU4cb

# Default on-screen setup: premium-ai | full-workflow
TRANSLATION_DEFAULT_SETUP=premium-ai

# Optional: MT engine numeric id for AI / last workflow step (default: AI Translation Agent)
# TMS_WF3_MT_ID=5239171

# Optional: max wait per TMS async step (import / AI / export). Default 30 minutes.
# TMS_ASYNC_TIMEOUT_MS=1800000

# Auth — create the first admin once (then manage users in the app UI)
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD="ChangeMe#1aB"
# Set true only when you want .env to overwrite the admin password on every startup
# AUTH_ADMIN_SYNC_PASSWORD=true
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_DAYS=7
# Set true when serving over HTTPS
AUTH_SECURE_COOKIE=false
# Optional legacy one-time import: user1:pass1|user2:pass2
# AUTH_USERS=

# Optional test user (non-admin) — created on first boot if username not taken
TEST_USER_USERNAME=tester
TEST_USER_PASSWORD="TestUser#1aB"
TEST_USER_WORD_QUOTA=5000
TEST_USER_CUSTOMERS=premium-ai

# Comma-separated allow-list. Do not use * on hosted (credentials + reflected Origin is unsafe).
# Local defaults also allow http://localhost:5173 and :8787 when HOSTED is not set.
CORS_ORIGIN=https://lingotrust-translate.onrender.com
MAX_UPLOAD_MB=50

# Local only — used when Ahmed asks to redeploy (never commit real values)
RENDER_API_KEY=
RENDER_SERVICE_ID=srv-damr4c5g1s2s73e1i27g
RENDER_SERVICE_URL=https://lingotrust-translate.onrender.com
